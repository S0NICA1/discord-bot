# ==============================================================================
# Mr. Roast 3.0 - Environment Configuration
# ==============================================================================

# [REQUIRED] Discord Bot Token
# Create an application and bot at https://discord.com/developers/applications
# Ensure Message Content Intent and Server Members Intent are enabled.
DISCORD_TOKEN=your_discord_bot_token_here

# [REQUIRED] Google Gemini API Key
# Generate an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# [REQUIRED/RECOMMENDED] Web Management Dashboard Port
# Render automatically injects PORT into the environment (default: 8080 or 10000)
PORT=8080

# [OPTIONAL] Administrator and Operational Settings
# ADMIN_USER_ID=0
# MAIN_CHANNEL_ID=0
